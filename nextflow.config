// Nextflow configuration for MetBio-WGSP pipeline

// Default parameters
params {
    // Input/Output
    input = null
    fastq_dir = null
    fasta_dir = null
    lineages_fasta = null
    reference_fasta = null
    index = null
    outdir = "results"
    final_outdir = null  // Override auto-derived output dir (e.g. --final_outdir results/R9)

    // General
    help = false
    filter_shuffled = false
    threads = 32
    minimap2_preset = 'map-ont'   // Alignment preset: 'map-ont' for Nanopore, 'sr' for Illumina

    // Kallisto parameters
    kmer_size = 31
    fragment_length = null
    sd = null

    // Freyja variants parameters
    refname = 'NC_045512.2'
    minq = 20

    // Freyja demix parameters
    freyja_eps = "0.001"
    covcut = 10
    depthcutoff = 0
    confirmedonly = false
    pathogen = 'SARS-CoV-2'
    barcodes = null

    // Freyja aggregate parameters
    mincov = 60

    // Freyja plot parameters
    thresh = 0
    lineage = null

    // Visualization
    create_plots = true

    // VILOCA parameters
    run_viloca = true
    viloca_container = 'viloca:latest'

    // HaploDMF parameters
    run_haplodmf = true
    haplodmf_container = 'haplodmf:latest'
    haplodmf_map_qual = 0          // -mq: Smallest mapping quality (default: 0)
    haplodmf_start_pos = null      // -sp: Starting position for reconstruction
    haplodmf_end_pos = null        // -ep: Ending position for reconstruction
    haplodmf_abundance = 0         // -a:  Filter haplotypes below this abundance (default: 0)
    haplodmf_error_rate = 0.1      // -e:  Sequencing error rate (default: 0.1)
    haplodmf_signi_level = 0.05    // -s:  Significance level for binomial tests (default: 0.05)
    haplodmf_cond_pro = 0.65       // -cp: Max conditional probability threshold (default: 0.65)
    haplodmf_fre_snv = 0.80        // -f:  Dominant base frequency threshold (default: 0.80)
    haplodmf_smallest_snv = 20     // -ss: Min SNV sites for haplotype construction (default: 20)
    haplodmf_weight = 0.2          // -w:  Weight for loss 2 in DMF (default: 0.2)
    haplodmf_learning_rate = 0.001 // -lr: Learning rate for DMF (default: 0.001)
    haplodmf_epoch = 20            // -epo: Training epochs (default: 20)
    haplodmf_batch_size = 128      // -bs: Batch size (default: 1024, reduce for low memory)
    haplodmf_algorithm = 'ward'    // -al: Clustering algorithm: ward or kmeans (default: ward)
    haplodmf_depth = 5             // -d:  Depth limit for consensus sequences (default: 5)
    haplodmf_cluster_thres1 = 0.95 // -c1: Edit distance threshold 1 (default: 0.95)
    haplodmf_cluster_thres2 = 0.90 // -c2: Edit distance threshold 2 (default: 0.90)
    haplodmf_largest_iter = 20     // -li: Largest clustering iteration (default: 20)
    haplodmf_input_snv = null      // -is: File with predefined SNV sites

    // Pangolin parameters
    run_pangolin = true
    pangolin_container = 'staphb/pangolin:4.4'
    nextclade_dataset = null  // Path to Nextclade dataset dir (e.g. databases/nextclade_sars2)

    // ONT preprocessing parameters
    // Порядок: NanoPlot(raw) → Porechop_ABI → Filtlong → Host depletion → NanoPlot(clean)
    run_ont_preprocess        = false  // Включить ONT preprocessing
    ont_min_quality           = 8      // Filtlong: min Phred score (default 8)
    ont_min_length            = 200    // Filtlong: min длина рида (bp)
    ont_target_bases          = null   // Filtlong: целевой объём баз (напр. 500000000 = 500Mb)
    ont_skip_adapter_trim     = false  // Пропустить Porechop_ABI
    ont_skip_quality_filter   = false  // Пропустить Filtlong
    ont_host_ref              = null   // Референс хозяина для депльеции (напр. hg38.fa)
    ont_skip_host_depletion   = true   // Пропустить host depletion (требует ont_host_ref)
    primer_bed                = null   // BED файл с праймерами (для iVar trim)
    run_ivar_trim             = false  // iVar primer trimming после выравнивания (ампликон)
    ivar_min_length           = 30
    ivar_min_quality          = 20

    // Kraken2/Bracken parameters
    run_kraken2 = false
    kraken2_db = null              // Path to Kraken2 database (required if run_kraken2 = true)
    kraken2_confidence = 0.0       // Confidence threshold for Kraken2 classification
    kraken2_min_hit_groups = 2     // Minimum number of hit groups for Kraken2
    bracken_read_len = 150         // Read length for Bracken (adjust for your data)
    bracken_level = 'S'            // Taxonomic level: D=Domain, P=Phylum, C=Class, O=Order, F=Family, G=Genus, S=Species
    bracken_threshold = 10         // Minimum reads for Bracken re-estimation
}

// Process configuration
process {
    // Parallel execution: Nextflow schedules processes based on available resources
    cpus = 16
    memory = '80 GB'
    time = '24h'

    // Error handling
    errorStrategy = 'retry'
    maxRetries = 2
}

// Execution profiles
profiles {
    local {
        process.executor = 'local'
        process.cpus = { Math.min(params.threads, Runtime.runtime.availableProcessors()) }
    }

    cluster {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.clusterOptions = '--time=24:00:00'
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {
            withName: 'FREYJA_ALIGN' {
                container = 'quay.io/biocontainers/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:1679e915ddb9d6b4abda91880c4b48857d471bd8-0'
                cpus = 4
                memory = '8 GB'
            }
            withName: 'FREYJA_VARIANTS|FREYJA_DEMIX|FREYJA_UPDATE|FREYJA_AGGREGATE|FREYJA_PLOT' {
                container = 'staphb/freyja:2.0.3'
                cpus = 4
                memory = '8 GB'
            }
            withName: 'KALLISTO_.*|LR_KALLISTO' {
                container = 'quay.io/biocontainers/kallisto:0.51.1--h2b92561_2'
                cpus = 4
                memory = '8 GB'
            }
            withName: 'VILOCA_RUN' {
                container = params.viloca_container
                cpus = 8
                memory = '16 GB'
            }
            withName: 'VILOCA_AGGREGATE' {
                container = 'ubuntu:22.04'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'HAPLODMF_RUN' {
                container = params.haplodmf_container
                cpus = 8
                memory = '16 GB'
                errorStrategy = 'ignore'
            }
            withName: 'HAPLODMF_AGGREGATE' {
                container = 'ubuntu:22.04'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'PANGOLIN_CLASSIFY' {
                container = params.pangolin_container
                cpus = 4
                memory = '8 GB'
            }
            withName: 'PANGOLIN_AGGREGATE' {
                container = 'ubuntu:22.04'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'KRAKEN2_CLASSIFY' {
                container = 'staphb/kraken2:2.1.3'
                cpus = 8
                memory = '16 GB'
                maxForks = 5  // DB loaded via memory-mapping, safe to parallelize
            }
            withName: 'BRACKEN_ABUNDANCE' {
                container = 'staphb/bracken:3.0'
                cpus = 2
                memory = '8 GB'
            }
            withName: 'KRAKEN2_AGGREGATE' {
                container = 'ubuntu:22.04'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'KRONA_REPORT' {
                container = 'nanozoo/krona:2.7.1--e7615f7'
                cpus = 1
                memory = '2 GB'
            }
            withName: 'KRAKEN2_PLOTS' {
                container = 'metbio-plots:latest'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'CREATE_WHO_PLOTS' {
                container = 'jupyter/scipy-notebook:latest'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'COVERAGE_PLOT' {
                container = 'staphb/freyja:2.0.3'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'NANOPLOT_RAW|NANOPLOT_CLEAN|NANOPLOT_SUMMARY' {
                container = 'staphb/nanoplot:1.46.2'
                cpus = 4
                memory = '8 GB'
            }
            withName: 'PORECHOP_ABI' {
                container = 'quay.io/biocontainers/porechop_abi:0.5.1--py310h275bdba_0'
                cpus = 16
                memory = '16 GB'
            }
            withName: 'FILTLONG' {
                container = 'staphb/filtlong:0.2.1'
                cpus = 2
                memory = '4 GB'
            }
            withName: 'HOST_DEPLETION' {
                container = 'quay.io/biocontainers/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:1679e915ddb9d6b4abda91880c4b48857d471bd8-0'
                cpus = 8
                memory = '16 GB'
            }
            withName: 'IVAR_TRIM' {
                container = 'staphb/ivar:1.4.4'
                cpus = 4
                memory = '4 GB'
            }
        }
    }
}

// Pipeline metadata
manifest {
    name = 'MetBio-WGSP'
    author = 'Victor Gordeev, Nicolae Drabcinski'
    homePage = 'https://github.com/nicolaedrabcinski/metbio_nextflow'
    description = 'Bioinformatics package for wastewater surveillance'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version = '1.0.0'
}

// Reporting
timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/dag.svg"
    overwrite = true
}
